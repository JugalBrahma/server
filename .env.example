# API Keys
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
LLM_PROVIDER=openrouter
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# Pinecone API Key
PINECONE_API_KEY=your_pinecone_api_key_here

# LLM Model Configuration (Groq / OpenAI)
# Examples: qwen/qwen3.6-27b, llama-3.3-70b-versatile, gpt-4o, gpt-4o-mini
AGENT_MODEL=qwen/qwen3.6-27b
AGENT_TEMPERATURE=0.7

# Retrieval reranking (FlashRank)
ENABLE_RERANKER=true
RETRIEVAL_FETCH_K=15
RERANK_TOP_K=8
RERANKER_MODEL=ms-marco-MiniLM-L-12-v2
# Use a durable mounted directory outside Docker. The supplied Docker image
# already contains this model in /opt/flashrank.
RERANKER_CACHE_DIR=./.cache/flashrank

# LangSmith Tracing Configuration
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=fusion-chat
LANGSMITH_API_KEY=lsv2_pt_your_api_key_here
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

