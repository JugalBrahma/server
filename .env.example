# API Keys
OPENAI_API_KEY=your_openai_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# Pinecone API Key
PINECONE_API_KEY=your_pinecone_api_key_here

# Answering model temperature (the model itself is OPENROUTER_MODEL above)
AGENT_TEMPERATURE=0.3

# Retrieval reranking (FlashRank)
ENABLE_RERANKER=true
RETRIEVAL_FETCH_K=20
RERANK_TOP_K=5
RERANKER_MODEL=ms-marco-MiniLM-L-12-v2
# Use a durable mounted directory outside Docker. The supplied Docker image
# already contains this model in /opt/flashrank.
RERANKER_CACHE_DIR=./.cache/flashrank

# LangSmith Tracing Configuration
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=fusion-chat
LANGSMITH_API_KEY=lsv2_pt_your_api_key_here
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

